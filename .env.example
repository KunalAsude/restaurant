# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Both are optional for the demo.

# Public URL of the site (used for WhatsApp / Google link previews).
# If empty on Vercel, the project's production *.vercel.app URL is used.
NEXT_PUBLIC_SITE_URL=

# Leave false while it is a demo, so Google does not index it.
# Set to true only when the restaurant approves and the site goes live.
NEXT_PUBLIC_ALLOW_INDEXING=false
